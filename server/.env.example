# Copy to .env (gitignored) and fill from your Supabase project dashboard.
# Auth tokens are validated via the Supabase auth API, so no JWT secret is needed —
# works with both legacy HS256 and modern asymmetric (RS256/ES256) signing.
SOCKET_PORT=3001
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY
CORS_ORIGIN=http://localhost:3000
