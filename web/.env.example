# Copy to .env.local (gitignored) and fill from your Supabase project dashboard.
# Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# URL where the Socket.io multiplayer server is reachable from the browser.
# - Local dev:  http://localhost:3001
# - Production: paste the Railway / Render / Fly URL of the deployed `server/`
#               (e.g. https://mines-server.up.railway.app)
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Optional — PostHog product analytics. Leave PROJECT_TOKEN blank to disable.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_ENABLED=false
